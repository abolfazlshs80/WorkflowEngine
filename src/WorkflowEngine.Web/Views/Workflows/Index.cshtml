@model List<WorkflowEngine.Domain.Entities.Workflow>
@{
    ViewData["Title"] = "Workflows";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Workflows</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Workflow</a>
</div>
<table class="table table-hover">
    <thead>
        <tr><th>Name</th><th>Status</th><th>Version</th><th>Created</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var w in Model)
        {
            <tr>
                <td>@w.Name</td>
                <td><span class="badge bg-secondary">@w.Status</span></td>
                <td>@w.Version</td>
                <td>@w.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@w.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    <a asp-action="Edit" asp-route-id="@w.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-controller="Designer" asp-action="Index" asp-route-id="@w.Id" class="btn btn-sm btn-outline-info">Designer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
